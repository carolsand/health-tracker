# Copy to .env and fill in real values. Never commit .env.
PORT=8317
SESSION_SECRET=replace-with-output-of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_PATH=./data/tracker.db
NODE_ENV=production
# Required for signup (POST /api/signup) to be enabled at all — share this
# only with people you want to be able to create an account. Unset = no signup.
INVITE_CODE=replace-with-a-code-you-share-with-people-you-invite
